<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base application theme. -->
    <style name="Theme.SimpleMedicineChecklist" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Customize your light theme here. -->
    </style>

    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <!-- Background color of the splash screen -->
        <item name="windowSplashScreenBackground">#CBE6FF</item>
        <!-- Icon to be displayed in the center -->
        <item name="windowSplashScreenAnimatedIcon">@drawable/app_icon_v2</item>
        <!-- The theme of the activity that will be used after the splash screen -->
        <item name="postSplashScreenTheme">@style/Theme.SimpleMedicineChecklist</item>
    </style>
</resources>