<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base application theme. -->
    <style name="Theme.DailyTasksChecklist" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Customize your light theme here. -->
    </style>

    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <!-- Background color of the splash screen -->
        <item name="windowSplashScreenBackground">#CBE6FF</item>
        <!-- Set the icon to transparent to "remove" it -->
        <item name="windowSplashScreenAnimatedIcon">@drawable/transparent</item>
        <!-- The theme of the activity that will be used after the splash screen -->
        <item name="postSplashScreenTheme">@style/Theme.DailyTasksChecklist</item>
    </style>
</resources>
