<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <!-- Background color of the splash screen in Dark Mode -->
        <item name="windowSplashScreenBackground">@color/splash_background</item>
        <!-- Reverted to original icon without padding -->
        <item name="windowSplashScreenAnimatedIcon">@drawable/icon_tasks</item>
        <!-- The theme of the activity that will be used after the splash screen -->
        <item name="postSplashScreenTheme">@style/Theme.DailyTasksChecklist</item>
    </style>
</resources>
